@inherits TabBase

<Alerta Mensaje="@Mensaje" EsError="@EsError" OnCerrar="CerrarMensaje" />

<div class="row g-3">
    <div class="col-12 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Productos Activos</span>
                <button class="btn btn-sm btn-primary" @onclick="Nuevo">Nuevo Producto</button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th class="text-center">STL</th>
                            <th class="text-center">Stock</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _productos)
                        {
                            <tr class="@(p.Id == _edit.Id ? "table-primary" : "")">
                                <td>
                                    <div class="fw-semibold">@p.Nombre</div>
                                    <small class="text-muted">@p.TipoImpresion | Costo Total: @p.CostoProduccion.ToString("C2")</small>
                                </td>
                                <td class="text-center">
                                    @if (p.TieneLink)
                                    {
                                        <a href="@p.UrlStl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary" title="Abrir link del archivo STL/3MF">🔗 STL</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center fw-bold">@p.StockActual</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" title="Editar" @onclick="() => Editar(p)">✏</button>
                                        <button class="btn btn-outline-success" title="Sumar tanda impresa" @onclick="() => _tanda = p">+</button>
                                        <button class="btn btn-outline-danger" title="Dar de baja" @onclick="() => DarBajaAsync(p.Id)">-</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_tanda is not null)
        {
            <div class="card border-success mt-3 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-success">Ingresar Tanda Impresa: @_tanda.Nombre</h6>
                    <div class="input-group mt-2">
                        <span class="input-group-text">Unidades impresas:</span>
                        <input type="number" min="1" class="form-control" @bind="_cantidadTanda" />
                        <button class="btn btn-success" @onclick="SumarTandaAsync">Sumar</button>
                        <button class="btn btn-outline-secondary" @onclick="() => _tanda = null">X</button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-12 col-lg-7">
        <ProductoForm Item="_edit" Filamentos="_filamentos" OnGuardar="GuardarAsync" />
    </div>
</div>
