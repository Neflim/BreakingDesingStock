@inherits TabBase

<Alerta Mensaje="@Mensaje" EsError="@EsError" OnCerrar="CerrarMensaje" />

<div class="row g-3">
    <div class="col-12 col-md-7">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Filamentos Activos</span>
                <button class="btn btn-sm btn-primary" @onclick="Nuevo">Nuevo Filamento</button>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Material</th>
                            <th>Color</th>
                            <th class="text-end">Precio por Kg</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in _filamentos)
                        {
                            <tr class="@(f.Id == _edit.Id ? "table-primary" : "")">
                                <td class="fw-semibold">@f.Nombre</td>
                                <td>@f.Material</td>
                                <td>@f.Color</td>
                                <td class="text-end fw-bold">@f.PrecioPorKg.ToString("C2")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Editar(f)">✏</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DarBajaAsync(f.Id)">🗑</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-5">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">@(_edit.Id == 0 ? "Nuevo Filamento" : $"Editando: {_edit.Nombre}")</div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label mb-1">Nombre (ej. PLA Negro):</label>
                    <input type="text" class="form-control" @bind="_edit.Nombre" />
                </div>
                <div class="mb-2">
                    <label class="form-label mb-1">Material (PLA, PETG, Silk):</label>
                    <input type="text" class="form-control" @bind="_edit.Material" />
                </div>
                <div class="mb-2">
                    <label class="form-label mb-1">Color:</label>
                    <input type="text" class="form-control" @bind="_edit.Color" />
                </div>
                <div class="mb-3">
                    <label class="form-label mb-1">Precio por Kg ($):</label>
                    <input type="number" step="0.01" min="1" class="form-control" @bind="_edit.PrecioPorKg" />
                </div>
                <button class="btn btn-primary w-100" @onclick="GuardarAsync">💾 Guardar Filamento</button>
            </div>
        </div>
    </div>
</div>
